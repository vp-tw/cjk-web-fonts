---
import FontCatalog from "../components/FontCatalog.svelte";
import { cdns, fonts } from "../lib/catalog";
import "../styles/catalog.css";
import "../styles/global.css";

const description = "CJK web fonts, ready to use.";
const base = import.meta.env.BASE_URL;
const assetBase = base.endsWith("/") ? base : `${base}/`;
const brandAsset = (filename: string) => `${assetBase}brand/${filename}`;
const canonicalUrl = new URL(base, Astro.site);
const ogImageUrl = new URL(brandAsset("og-image.png"), Astro.site);
---

<!doctype html>
<html lang="zh-Hant" data-theme="system">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#e7e3d8" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="CJK Web Fonts" />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="CJK web fonts, ready to use." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="CJK Web Fonts" />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href={`${assetBase}favicon.ico`} sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href={brandAsset("favicon-32.png")} />
    <link rel="icon" type="image/png" sizes="16x16" href={brandAsset("favicon-16.png")} />
    <link rel="apple-touch-icon" sizes="180x180" href={brandAsset("apple-touch-icon.png")} />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/@vp-tw/cjk-web-fonts-taipei-sans-tc@0.0.1/dist/Regular/Taipei-Sans-TC.css"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/@vp-tw/cjk-web-fonts-taipei-sans-tc@0.0.1/dist/Bold/Taipei-Sans-TC.css"
    />
    <title>CJK Web Fonts — Ready to use</title>
    <script is:inline>
      const savedTheme = localStorage.getItem("cjk-theme");
      if (["light", "dark", "system"].includes(savedTheme)) {
        document.documentElement.dataset.theme = savedTheme;
      }
    </script>
  </head>
  <body>
    <!--
      THESIS: Let users paste real text and identify fonts that contain every required character.
      OWN-WORLD: A technical type-specimen registry maintained by VP-TW.
      STORY: Enter text, adjust proof settings, compare coverage, then copy a version-pinned CDN embed.
      FIRST VIEWPORT: The editable proof and core controls are visible before catalog results.
      FORM: International typographic standards manual and press-room specification sheet. Concept seed 354598da.
      FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, DESIGN.md, and every shipping raster carrying its provenance
    -->
    <header class="site-header">
      <a class="wordmark" href={base}>
        <span class="brand-mark-frame" aria-hidden="true">
          <img class="brand-mark" src={brandAsset("logo-64.png")} alt="" width="40" height="40" />
        </span>
        <span class="wordmark-copy">
          CJK Web Fonts
          <small>CJK web fonts, ready to use.</small>
        </span>
      </a>
      <nav aria-label="主要導覽">
        <a href="#proof-title">開始檢查</a>
        <a href="https://github.com/vp-tw/cjk-web-fonts">GitHub</a>
      </nav>
    </header>

    <main>
      <FontCatalog {fonts} {cdns} client:load />
    </main>

    <footer class="site-footer">
      <span>CJK Web Fonts is maintained by VP–TW. Font licenses follow their upstream projects.</span>
      <a href="https://github.com/vp-tw/cjk-web-fonts">Source and package documentation</a>
    </footer>
  </body>
</html>
